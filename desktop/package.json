{
  "name": "interview-copilot-desktop",
  "version": "1.0.0",
  "description": "Windows playback audio companion for Interview Copilot",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.interviewcopilot.desktop",
    "productName": "Interview Copilot Desktop",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "launcher-preload.cjs",
      "launcher.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
